{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [".nvmrc", "bun.lock"],
	"globalEnv": ["NODE_ENV"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".turbo/**"]
		},
		"clean": {},
		"format": { "cache": true },
		"format:check": { "cache": true },
		"lint": { "cache": true },
		"lint:fix": { "cache": true }
	}
}
