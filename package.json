{
	"name": "@mheob/config",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"changeset": "changeset",
		"clean": "turbo run clean",
		"clean:root": "rm -rf .turbo node_modules",
		"cspell": "cspell .",
		"cve": "cve-lite . --fail-on high --verbose --cache-dir .cache/cve-lite",
		"format": "turbo run format",
		"format:check": "turbo run format:check",
		"lint": "turbo run lint && pnpm run lint:root",
		"lint:fix": "turbo run lint:fix && pnpm run lint:root -- --fix",
		"lint:root": "oxlint --ignore-pattern packages",
		"prepare": "lefthook install",
		"release": "changeset publish",
		"version-packages": "changeset version && pnpm lint"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@commitlint/cli": "catalog:",
		"@cspell/dict-de-de": "catalog:",
		"@mheob/changeset-changelog": "catalog:",
		"@mheob/commitlint-config": "workspace:*",
		"@mheob/oxfmt-config": "workspace:*",
		"@mheob/oxlint-config": "workspace:*",
		"@types/node": "catalog:",
		"cspell": "catalog:",
		"cve-lite-cli": "catalog:",
		"czg": "catalog:",
		"lefthook": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": "^24.0.0 || >=26.0.0"
	},
	"packageManager": "pnpm@11.24.0"
}
