{
	"name": "@mheob/oxlint-config",
	"version": "4.1.0",
	"private": false,
	"description": "Shared OXLint configuration",
	"keywords": [
		"config",
		"oxlint",
		"oxlintconfig"
	],
	"homepage": "https://github.com/mheob/config/tree/main/packages/oxlint-config",
	"bugs": "https://github.com/mheob/config/issues",
	"license": "MIT",
	"author": "Alexander Böhm <tools@alex-boehm.dev>",
	"repository": {
		"type": "git",
		"url": "https://github.com/mheob/config"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack --clean",
		"clean": "rm -rf .turbo node_modules dist",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"test": "vp test"
	},
	"devDependencies": {
		"@mheob/internal": "workspace:*",
		"@types/node": "catalog:",
		"eslint-plugin-better-tailwindcss": "catalog:",
		"eslint-plugin-regexp": "catalog:",
		"eslint-plugin-storybook": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"eslint-plugin-better-tailwindcss": "catalog:",
		"eslint-plugin-regexp": "catalog:",
		"eslint-plugin-storybook": "catalog:",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2003"
	},
	"peerDependenciesMeta": {
		"eslint-plugin-better-tailwindcss": {
			"optional": true
		},
		"eslint-plugin-regexp": {
			"optional": true
		},
		"eslint-plugin-storybook": {
			"optional": true
		},
		"oxlint": {
			"optional": false
		},
		"oxlint-tsgolint": {
			"optional": false
		}
	},
	"engines": {
		"node": ">=24"
	}
}
