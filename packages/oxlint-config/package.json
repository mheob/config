{
	"name": "@mheob/oxlint-config",
	"version": "3.0.0",
	"private": false,
	"description": "Shared OXLint configuration",
	"keywords": [
		"config",
		"oxlint",
		"oxlintconfig"
	],
	"homepage": "https://github.com/mheob/config/tree/main/packages/oxlint-config",
	"bugs": "https://github.com/mheob/config/issues",
	"license": "MIT",
	"author": "Alexander Böhm <tools@alex-boehm.dev>",
	"repository": {
		"type": "git",
		"url": "https://github.com/mheob/config"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run --bun tsdown --clean",
		"clean": "bun run --bun rm -rf .turbo node_modules dist",
		"format": "bun run --bun oxfmt",
		"format:check": "bun run --bun oxfmt --check",
		"lint": "bun run --bun oxlint",
		"lint:fix": "bun run --bun oxlint --fix"
	},
	"devDependencies": {
		"@mheob/internal": "workspace:*",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-jsonc": "^3.4.1",
		"eslint-plugin-regexp": "^3.1.1",
		"eslint-plugin-storybook": "^10.5.6",
		"eslint-plugin-yml": "^3.8.1",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"oxlint-tsgolint": "^7.0.2001",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"eslint-plugin-better-tailwindcss": "^4.3.2",
		"eslint-plugin-jsonc": "^3.4.1",
		"eslint-plugin-regexp": "^3.1.0",
		"eslint-plugin-storybook": "^10.5.6",
		"eslint-plugin-yml": "^3.8.1",
		"oxlint": "^1.77.0",
		"oxlint-tsgolint": "^7.0.2001"
	},
	"peerDependenciesMeta": {
		"eslint-plugin-better-tailwindcss": {
			"optional": true
		},
		"eslint-plugin-jsonc": {
			"optional": true
		},
		"eslint-plugin-regexp": {
			"optional": true
		},
		"eslint-plugin-yml": {
			"optional": true
		},
		"eslint-plugin-storybook": {
			"optional": true
		},
		"oxlint": {
			"optional": false
		},
		"oxlint-tsgolint": {
			"optional": false
		}
	},
	"engines": {
		"node": ">=24"
	}
}
