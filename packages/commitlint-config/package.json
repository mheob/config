{
	"name": "@mheob/commitlint-config",
	"version": "2.0.8",
	"description": "My personal configuration for commitlint.",
	"keywords": [
		"commitlint",
		"config"
	],
	"homepage": "https://github.com/mheob/config/tree/main/packages/commitlint-config",
	"bugs": "https://github.com/mheob/config/issues",
	"license": "MIT",
	"author": "Alexander Böhm <tools@alex-boehm.dev>",
	"repository": {
		"type": "git",
		"url": "https://github.com/mheob/config"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack --clean",
		"clean": "rm -rf .turbo node_modules dist",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"test": "vp test"
	},
	"dependencies": {
		"conventional-changelog-conventionalcommits": "catalog:"
	},
	"devDependencies": {
		"@commitlint/cli": "catalog:",
		"@mheob/internal": "workspace:*",
		"@mheob/oxfmt-config": "workspace:*",
		"@mheob/oxlint-config": "workspace:*",
		"@mheob/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"czg": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"@commitlint/cli": "catalog:",
		"czg": "catalog:"
	},
	"engines": {
		"node": ">=24"
	}
}
